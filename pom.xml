<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>kpfl</groupId>
  <artifactId>kpfl</artifactId>
  <version>1.0</version>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <!-- "mvn package" builds a jar you can start with: java -jar target/kpfl-1.0.jar -->
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>kpfl.ui.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <!-- The tests are plain programs with a main() method, not JUnit tests.
           "mvn verify" runs all four of them and fails the build if any check fails. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.3.0</version>
        <executions>
          <execution><id>member1</id><phase>verify</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>kpfl.Member1Tests</mainClass><classpathScope>test</classpathScope></configuration></execution>
          <execution><id>member2</id><phase>verify</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>kpfl.Member2Tests</mainClass><classpathScope>test</classpathScope></configuration></execution>
          <execution><id>member4</id><phase>verify</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>kpfl.Member4Tests</mainClass><classpathScope>test</classpathScope></configuration></execution>
          <execution><id>integration</id><phase>verify</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>kpfl.IntegrationTests</mainClass><classpathScope>test</classpathScope></configuration></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
